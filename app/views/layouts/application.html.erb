<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:title) ? yield(:title) : "Trucks of Nevada | Semi-Truck Repair" %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="author" content="Trucks of Nevada">
  <meta name="robots" content="index, follow">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= display_meta_tags %> <!-- This will render the meta tags dynamically from ApplicationController -->

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <%= favicon_link_tag 'favicon.ico' %>

<% if Rails.env.production? %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-359263349"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    // Initialize GA4 and Google Ads base
    gtag('config', 'G-C34J9TNX1Y');
    gtag('config', 'AW-359263349');

    var setupPhoneTracking = function() {
      // 1. PHONE NUMBER SWAPPING (Google Ads)
      // Updated with your specific Conversion Label and Number
      gtag('config', 'AW-359263349/jnwaCIeuh9cZEPXYp6sB', {
        'phone_conversion_number': '(702) 333-2463',
        'phone_conversion_callback': function(display_number, non_formatted_number) {
          var elements = document.getElementsByClassName('phone-number');
          for (var i = 0; i < elements.length; i++) {
            elements[i].href = "tel:" + non_formatted_number;
            
            // Replaces original text with the Google forwarding number
            if (elements[i].innerHTML.includes("(702) 333-2463") || elements[i].innerHTML.includes("CLICK TO CALL")) {
              elements[i].innerHTML = display_number;
            }
          }
        }
      });

      // 2. CLICK TRACKING (GA4)
      var elements = document.getElementsByClassName('phone-number');
      for (var i = 0; i < elements.length; i++) {
        elements[i].addEventListener('click', function() {
          gtag('event', 'phone_call_click', {
            'event_category': 'Contact',
            'event_label': 'Website Phone Click'
          });
        }, { once: true });
      }
    };

    // Handle Rails Turbo/Turbolinks lifecycle
    document.addEventListener("turbo:load", setupPhoneTracking);
    document.addEventListener("turbolinks:load", setupPhoneTracking);
  </script>
<% end %>


</head>


  <body>
    <div class="header">
      <div id="div1">
          <span>
          <i class="fa-solid fa-clock"></i>
          Mon - Fri: 9:30am - 5.30pm
        </span>
        <span>
          <i class="fa-solid fa-envelope"></i>
          <%= link_to "info@trucksofnevada.com", "mailto:info@trucksofnevada.com" %>
        </span>
        <span>
          <i class="fa-solid fa-clock"></i>
          Road Assist - 24HR
        </span>
          <span>
          <i class="fa-solid fa-phone"></i>
          <%= link_to "(702) 333-2463", "tel:+17023332463", class: "phone-number"%>
        </span>
      </div>
      <div id="div2">
        <span>
          <%= link_to "https://www.facebook.com/people/Trucks-of-Nevada/100068634909107/", target: "_blank" do%>
          <i class="fa-brands fa-facebook"></i>
          <%end%>
        </span>

        <span>
          <%= link_to "https://www.instagram.com/trucksofnevada/", target: "_blank" do%>
          <i class="fa-brands fa-square-instagram"></i>
          <%end%>
        </span>

        <span>
        <a href="https://www.google.com/maps/place/Trucks+of+Nevada/@36.2160166,-115.1426227,17z/data=!3m1!4b1!4m6!3m5!1s0x80c8c3a9ef9f49d1:0xae845d6b3c2bd27d!8m2!3d36.2160166!4d-115.1426227!16s%2Fg%2F11nn7bw89h?entry=ttu&g_ep=EgoyMDI0MTExOS4yIKXMDSoASAFQAw%3D%3D" target="_blank">
        <i class="fa-solid fa-map-location-dot"></i>
        </a>
        </span>
      </div>
    </div>

    <div class="navbar" data-controller="navbar">
      <div class="nav-div1">
        <%= link_to root_path, class: "navbar-brand" do %>
          <%= image_tag "trucks_of_nevada_logo.png", class: "logo"%>
        <% end %>
      </div>

      <button class="hamburger" data-action="click->navbar#toggle">
        <i class="fa fa-bars"></i>
      </button>

      <div class="nav-div2" data-navbar-target="menu">
        <%= link_to root_path, class: "#{'active' if current_page?(root_path)}" do %>
          Home
        <% end %>

        <div class="subnav">
          <%= link_to services_path, class: "#{'active' if current_page?(services_path)}" do %>
           Services
          <% end %>
          <button class="subnavbtn">
           <i class="fa fa-caret-down"></i>
          </button>
          <div class="subnav-content" data-navbar-target="dropdown">
            <%= link_to diagnostic_path, class: "#{'active' if current_page?(diagnostic_path)}" do %> Diagnostics & Inspection <% end%>
            <%= link_to aftertreatment_path, class: "#{'active' if current_page?(aftertreatment_path)}" do %> Aftertreatment <% end%>
            <%= link_to maintenance_path, class: "#{'active' if current_page?(maintenance_path)}" do %> Oil Change & Maintenance <% end%>
          </div>
        </div>


        <%= link_to roadside_assistance_path, class: "#{'active' if current_page?(roadside_assistance_path)}" do %>
          Roadside Assistance
        <% end%>

        <%= link_to fleet_services_path, class: "#{'active' if current_page?(fleet_services_path)}" do %>
          Fleet Services
        <% end%>

        <%= link_to about_path, class: "#{'active' if current_page?(about_path)}" do %>
          About Us
        <% end%>
      </div>

    </div>

    <% if current_page?(diagnostic_path) || current_page?(aftertreatment_path) || current_page?(maintenance_path) %>
      <div class="breadcrumb-section">
        YOU ARE HERE:
        <%= link_to "HOME", root_path %> /
        <%= link_to "SERVICES", services_path %> /
        <span class="active">
          <% if current_page?(diagnostic_path) %> Diagnostics & Inspection <% end %>
          <% if current_page?(aftertreatment_path) %> Aftertreatment <% end %>
          <% if current_page?(maintenance_path) %> Oil Change & Maintenance <% end %>
        </span>
      </div>
    <% end %>


    <%= yield %>
      <div class="footer">
        <div class="div">
          <span>
            <i class="fa-solid fa-map-location-dot"></i>
            <a href="https://www.google.com/maps/place/Trucks+of+Nevada/@36.2160166,-115.1426227,17z/data=!3m1!4b1!4m6!3m5!1s0x80c8c3a9ef9f49d1:0xae845d6b3c2bd27d!8m2!3d36.2160166!4d-115.1426227!16s%2Fg%2F11nn7bw89h?entry=ttu&g_ep=EgoyMDI0MTExOS4yIKXMDSoASAFQAw%3D%3D" target="_blank">
              Las Vegas, NV 89030
              <br>
              3050 N Commerce St. Suite B
            </a>
          </span>
        </div>
        <div class="div">
          <span>
            <i class="fa-solid fa-phone"></i>
            <a href="tel:+17023332463" class="phone-number">Feel Free to Call Us
              <br>
              (702) 333-2463
            </a>
          </span>
        </div>
        <div class="div">
        <span>
          <i class="fa-solid fa-clock"></i>
          Shop Hours Mon - Fri :
          <br> 9:30am - 5:30pm
        </span>
        </div>
      </div>
  </body>
</html>
