<!DOCTYPE html>
<html>
  <head>
    <title>TrucksApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="header">
      <div id="div1">
      <span>
        <i class="fa-solid fa-phone"></i>
        <%= link_to "(702) 333-2463", "tel:+17023332463" %>
      </span>
      <span>
        <i class="fa-solid fa-envelope"></i>
        <%= link_to "info@trucksofnevada.com", "mailto:info@trucksofnevada.com" %>
      </span>
      <span>
        <i class="fa-solid fa-clock"></i>
        Mon - Fri: 9:30am - 5.30pm
      </span>
      <span>
        <i class="fa-solid fa-clock"></i>
        Road Assist - 24HR
      </span>
      </div>
      <div id="div2">
      <span><i class="fa-brands fa-facebook"></i></span>
      <span><i class="fa-brands fa-square-instagram"></i></span>
      <span>
      <a href="https://www.google.com/maps/place/Trucks+of+Nevada/@36.2160166,-115.1426227,17z/data=!3m1!4b1!4m6!3m5!1s0x80c8c3a9ef9f49d1:0xae845d6b3c2bd27d!8m2!3d36.2160166!4d-115.1426227!16s%2Fg%2F11nn7bw89h?entry=ttu&g_ep=EgoyMDI0MTExOS4yIKXMDSoASAFQAw%3D%3D" target="_blank">
      <i class="fa-solid fa-map-location-dot"></i>
      </a>
      </span>
      </div>
    </div>
    <div class="navbar">
      <div class="nav-div1">
        <%= link_to root_path, class: "navbar-brand" do %>
        <%= image_tag "logo.png", class: "logo"%>
        <% end %>
      </div>

      <div class="nav-div2">
        <%= link_to root_path do %>
          Home
        <% end%>

        <div class="subnav">
          <button class="subnavbtn">Services <i class="fa fa-caret-down"></i></button>
          <div class="subnav-content">
            <%= link_to diagnostic_path do %>
            Diagnostic & Inspection
            <% end%>
            <%= link_to aftertreatment_path do %>
            Aftertreatment
            <% end%>
            <%= link_to maintenance_path do %>
            Oil Change & Maintenance
            <% end%>
          </div>
        </div>
        <%= link_to roadside_assistance_path do %>
          Roadside Assistance
        <% end%>
        <%= link_to fleet_services_path do %>
          Fleet Services
        <% end%>
        <%= link_to blog_path do %>
          Blog
        <% end%>
        <%= link_to about_path do %>
          About Us
        <% end%>
      </div>
    </div>
    <%= yield %>
      <div class="footer">
        <div class="div">
        <span>
        <i class="fa-solid fa-map-location-dot"></i>
        <a href="https://www.google.com/maps/place/Trucks+of+Nevada/@36.2160166,-115.1426227,17z/data=!3m1!4b1!4m6!3m5!1s0x80c8c3a9ef9f49d1:0xae845d6b3c2bd27d!8m2!3d36.2160166!4d-115.1426227!16s%2Fg%2F11nn7bw89h?entry=ttu&g_ep=EgoyMDI0MTExOS4yIKXMDSoASAFQAw%3D%3D" target="_blank">
        Las Vegas, NV 89030
          <br>
        3050 N Commerce St. Suite B
        </a>
        </span>
        </div>
        <div class="div">
        <span>
          <i class="fa-solid fa-phone"></i>
          <a href="tel:+17023332463">Feel Free to Call Us
            <br>
            (702) 333-2463
          </a>
        </span>
        </div>
        <div class="div">
        <span>
          <i class="fa-solid fa-clock"></i>
          Shop Hours Mon - Fri :
          <br> 9:30am - 5:30pm
        </span>
        </div>
      </div>
  </body>
</html>
