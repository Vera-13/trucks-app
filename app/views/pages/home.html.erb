<div class="container-page">
  <div class="carousel" data-controller="carousel">
    <div class="carousel-track" data-carousel-target="track">
      <div class="carousel-slide" data-carousel-target="slide">
        <%= ik_image_tag("/Trucks/carousel1.jpg", fetch_format: :auto, quality: :auto, alt: "Slide 1") %>
        <div class="carousel-content">
          <h2>PEACE OF MIND ON THE ROAD</h2>
          <br>
          <%= link_to "HEAVY DUTY SERVICES", services_path, class: "carousel-button" %>
        </div>
      </div>
      <div class="carousel-slide" data-carousel-target="slide">
        <%= ik_image_tag("Trucks/carousel2.jpg", fetch_format: :auto, quality: :auto, alt: "Slide 2") %>
        <div class="carousel-content">
          <h2>YOUR PARTNER IN RELIABILITY</h2>
          <br>
          <%= link_to "LEARN MORE", services_path, class: "carousel-button" %>
        </div>
      </div>
      <div class="carousel-slide" data-carousel-target="slide">
        <%= ik_image_tag("Trucks/carousel3.jpg", fetch_format: :auto, quality: :auto, alt: "Slide 3") %>
        <div class="carousel-content">
          <h2>ROADSIDE ASSISTANCE NEAR <br>LAS VEGAS</h2>
          <br>
          <%= link_to "OUR SERVICES", roadside_assistance_path, class: "carousel-button" %>
        </div>
      </div>
    </div>
    <button class="carousel-prev" data-action="carousel#prev">❮</button>
    <button class="carousel-next" data-action="carousel#next">❯</button>
  </div>

  <section class="emergency-banner">
    <div class="banner-content">
      <p>CALL AND TALK TO OUR SERVICE ADVISOR</p>
      <a href="tel:+17023332463" class="call-button">CLICK TO CALL</a>
    </div>
  </section>

  <section class="section">
    <h1>TRUCKS OF NEVADA SEMI TRUCK REPAIR SHOP</h1>
    <p>Bring your heavy duty commercial truck to our repair shop in Las Vegas.<br>We provide the best maintenance and repairs.</p>
    <div class="cards">
      <div class="card">
        <div class="hex-icon"><i class="fa-solid fa-people-group"></i></div>
        <h2>GREAT TEAM</h2>
        <p>Expect great customer service from the first phone call to your first visit.</p>
      </div>
      <div class="card">
        <div class="hex-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
        <h2>WIDE RANGE OF SERVICES</h2>
        <p>Diagnostic, Oil Change or Engine Repairs... We can handle it all.</p>
      </div>
      <div class="card">
        <div class="hex-icon"><i class="fa-solid fa-truck-fast"></i></div>
        <h2>ROADSIDE ASSISTANCE</h2>
        <p>Major breakdown around Las Vegas? Call us 24/7.</p>
      </div>
    </div>
  </section>

  <section class="services-section">
    <div class="service-images">
      <div class="image-container overlay-container">
        <%= ik_image_tag("Trucks/overlay1.jpg", fetch_format: :auto, quality: :auto, alt: "Diagnostics") %>
        <div class="overlay">
          <h3>Diagnostics & Inspection</h3>
          <%= link_to "READ MORE", diagnostic_path, class: "read-more" %>
        </div>
      </div>
      <div class="image-container overlay-container">
        <%= ik_image_tag("Trucks/overlay2.jpg", fetch_format: :auto, quality: :auto, alt: "Aftertreatment") %>
        <div class="overlay">
          <h3>Aftertreatment</h3>
          <%= link_to "READ MORE", aftertreatment_path, class: "read-more" %>
        </div>
      </div>
      <div class="image-container overlay-container">
        <%= ik_image_tag("Trucks/overlay3.jpg", fetch_format: :auto, quality: :auto, alt: "Maintenance") %>
        <div class="overlay">
          <h3>Oil Change and Maintenance</h3>
          <%= link_to "READ MORE", maintenance_path, class: "read-more" %>
        </div>
      </div>
      <div class="image-container overlay-container">
        <%= ik_image_tag("Trucks/overlay4.jpg", fetch_format: :auto, quality: :auto, alt: "Roadside") %>
        <div class="overlay">
          <h3>Roadside Assistance</h3>
          <%= link_to "READ MORE", roadside_assistance_path, class: "read-more" %>
        </div>
      </div>
    </div>
  </section>

  <section class="logos" data-controller="logo-section">
    <div class="slider">
      <ul class="brands" data-logo-section-target="track">
        <li class="brand-logo"><%= ik_image_tag("Trucks/img1.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img2.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img3.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img4.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img5.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img6.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img7.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img8.jpg", fetch_format: :auto, quality: :auto) %></li>
        <li class="brand-logo"><%= ik_image_tag("Trucks/img9.jpg", fetch_format: :auto, quality: :auto) %></li>
      </ul>
    </div>
    <div class="slider-dots" data-logo-section-target="dots">
      <span data-action="click->logo-section#goToSlide" data-index="0" class="dot active"></span>
      <span data-action="click->logo-section#goToSlide" data-index="1" class="dot"></span>
      <span data-action="click->logo-section#goToSlide" data-index="2" class="dot"></span>
    </div>
  </section>
</div>