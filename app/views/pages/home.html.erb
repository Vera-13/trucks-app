          <h2>PEACE OF MIND ON THE ROAD</h2>
          <button class="carousel-button">HEAVY DUTY SERVICES</button>
        </div>
      </div>
      <div class="carousel-slide" data-carousel-target="slide">
        <img src="image2.jpg" alt="Slide 2">
