<% used_photos = [] %>
<% hero = take_photo("home", used_photos) %>
<section class="hero <%= "has-photo" if hero %>" <% if hero %>style="<%= hero_photo_style(hero) %>"<% end %>>
  <div class="wrap hero-copy">
    <h1>Semi-Truck &amp; Trailer Repair in Las Vegas</h1>
    <p class="lede">Expert Heavy-Duty Diagnostics, Engine Repairs, Electrical Systems &amp; DPF/DEF Solutions.</p>
    <%= phone_link "Call Now (702) 333-2463", class: "btn-call" %>
  </div>
</section>

<section class="trust">
  <div class="wrap trust-grid">
    <p><i class="fa-solid fa-users"></i> Heavy-Duty Specialists</p>
    <p><i class="fa-solid fa-certificate"></i> ASE-Certified Technicians</p>
    <p><i class="fa-solid fa-bolt"></i> Same-Day Service Available</p>
    <p><i class="fa-solid fa-road"></i> 24/7 Roadside Assistance</p>
    <p><i class="fa-solid fa-award"></i> 10+ Years of Experience</p>
    <p><%= link_to reviews_path do %><i class="fa-solid fa-comments"></i> Customer-Rated Service<% end %></p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="section-head">
      <h2>Heavy-Duty Repairs. Accurate Diagnostics. Less Downtime.</h2>
      <p>At Trucks of Nevada, we understand that every hour your truck is out of service costs you money. Our experienced technicians specialize in commercial semi-truck and trailer repairs, from advanced engine diagnostics and electrical troubleshooting to major mechanical repairs and aftertreatment systems.</p>
      <p>We serve owner-operators and commercial fleets throughout Las Vegas, focusing on accurate diagnosis, quality workmanship, and getting your equipment back on the road as efficiently as possible.</p>
    </div>
    <div class="card-grid">
      <% SiteContent.featured.each do |service| %>
        <%= link_to public_send("#{service.slug.tr("-", "_")}_path"), class: "service-card" do %>
          <% photo = shop_photo(service.slug) %>
          <% if photo %>
            <%= image_tag photo, alt: photo_alt(photo), class: "card-photo" %>
          <% else %>
            <span class="card-icon"><i class="<%= service.icon %>"></i></span>
          <% end %>
          <span class="card-body">
            <strong><%= service.card_name.presence || service.name %></strong>
            <em>Learn More</em>
          </span>
        <% end %>
      <% end %>
    </div>
    <p class="section-link"><%= link_to "All services", services_path %></p>
  </div>
</section>

<section class="bay-reel" aria-label="In the bay" data-controller="bay-reel">
  <div class="bay-reel-line" aria-hidden="true"></div>
  <div class="bay-reel-viewport">
    <div class="bay-reel-track" data-bay-reel-target="track">
      <% tilts = [-3.2, 2.6, -1.4, 3.8, -2.5, 1.7, -4, 2.9, -1.8, 3.2, -2.8, 1.2] %>
      <% bay_reel_photos.each_with_index do |(path, alt), index| %>
        <figure class="polaroid" style="--tilt: <%= tilts[index % tilts.length] %>deg">
          <span class="polaroid-clip" aria-hidden="true"></span>
          <%= image_tag path, alt: alt %>
        </figure>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/call_band",
      title: "Semi-Truck Breakdown? Call for Roadside Assistance.",
      text: "Unexpected breakdowns can disrupt your deliveries and cost valuable time. Trucks of Nevada provides commercial truck roadside assistance throughout Las Vegas, Henderson, North Las Vegas, and surrounding highways, including I-15, US-95, and US-93." %>

<section class="band band-dark">
  <div class="wrap split">
    <div>
      <h2>Why Truck Owners Choose Trucks of Nevada</h2>
      <p>At Trucks of Nevada, we believe quality repairs begin with accurate diagnostics. Our team works to identify the root cause of mechanical, electrical, and aftertreatment problems rather than simply replacing parts and hoping for the best.</p>
      <p>We provide professional repair solutions for owner-operators and commercial fleets, with a focus on dependable workmanship, clear communication, and minimizing unnecessary downtime.</p>
    </div>
    <ul class="check-list">
      <li>Advanced Diagnostics — Electrical, engine, transmission, and aftertreatment troubleshooting.</li>
      <li>Commercial Truck Specialists — Freightliner, Volvo, Kenworth, Peterbilt, International, Mack, and more.</li>
      <li>Fleet &amp; Owner-Operator Support — Repairs, inspections, and preventive maintenance.</li>
      <li>Efficient Turnaround — Same-day service when scheduling, repair requirements, and parts availability permit.</li>
    </ul>
  </div>
</section>

<section class="quote-band">
  <div class="wrap"
    data-controller="quote-cycle"
    data-action="mouseenter->quote-cycle#pause mouseleave->quote-cycle#resume">
    <div class="quote-head">
      <div>
        <p class="eyebrow">Drivers on Google</p>
        <p class="star-row star-row-lg" aria-label="5 out of 5">
          <% 5.times do %><span class="star" style="--fill: 100%"></span><% end %>
        </p>
      </div>
      <%= link_to GoogleReviews::PROFILE_URL, class: "google-cta quote-google", target: "_blank", rel: "noopener noreferrer" do %>
        <%= image_tag "icons/google-g.svg", alt: "" %>
        <span>
          Leave a review
          <small>On the shop’s Google listing</small>
        </span>
      <% end %>
    </div>
    <div class="quote-stage" data-quote-cycle-target="stage">
      <% GoogleReviews.reviews.select { |review| ["Constantin Cascaval", "Romeo Lun", "Taras Yevtushyk"].include?(review[:author]) }.each_with_index do |review, index| %>
        <blockquote class="quote-slide <%= "is-on" if index.zero? %>" data-quote-cycle-target="slide" <%= "aria-hidden=true" unless index.zero? %>>
          <p><%= review[:body] %></p>
          <footer>
            <cite><%= review[:author] %></cite>
            <time datetime="<%= review[:date] %>"><%= Date.parse(review[:date]).strftime("%B %-d, %Y") %></time>
          </footer>
        </blockquote>
      <% end %>
    </div>
    <%= link_to "Read Our Google Reviews", reviews_path, class: "btn-call" %>
  </div>
</section>

<section class="makes">
  <div class="wrap">
    <h2>Commercial Truck Brands We Service</h2>
    <p class="makes-note">Independent repair services for major heavy-duty truck manufacturers.</p>
    <ul class="make-logos">
      <% [
        ["Volvo", "brands/volvo.svg"],
        ["Freightliner", "brands/freightliner.png", true],
        ["Kenworth", "brands/kenworth.png", true],
        ["International", "brands/international.svg", true],
        ["Peterbilt", "brands/peterbilt.svg"],
        ["Mack", "brands/mack.svg"],
        ["Western Star", "brands/western-star.svg"],
        ["Hino", "brands/hino.svg", true],
        ["Isuzu", "brands/isuzu.svg", true]
      ].each do |name, file, wide| %>
        <li class="<%= "is-wide" if wide %>"><%= image_tag file, alt: name %></li>
      <% end %>
    </ul>
    <p class="makes-note">And more. Don’t see your truck? <%= phone_link "Just call (702) 333-2463" %>.</p>
  </div>
</section>
