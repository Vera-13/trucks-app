<% photo = page_photo("service-areas") %>
<section class="page-hero <%= "has-photo" if photo %>" <% if photo %>style="<%= hero_photo_style(photo) %>"<% end %>>
  <div class="wrap">
    <p class="eyebrow">About 100 miles from the shop</p>
    <h1>Where we come to you</h1>
    <p class="lede">The shop is at 1260 Rockpebble Ave. We come to trucks across Las Vegas and on the highways around it.</p>
    <%= phone_link "Call Now (702) 333-2463", class: "btn-call" %>
  </div>
</section>

<% content_for :head do %>
  <%= stylesheet_link_tag "leaflet" %>
<% end %>

<section class="band">
  <div class="wrap">
    <div class="section-head">
      <h2>About 100 miles out</h2>
      <p>The blue dot is the shop. We cover about 100 miles around it, with 24/7 roadside on I-15, US-95, and US-93.</p>
    </div>
    <div class="area-map" data-controller="service-area-map" role="region" aria-label="Map of the service area"></div>
    <p class="area-map-link"><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=1260+Rockpebble+Ave,+North+Las+Vegas,+NV+89030" target="_blank" rel="noopener noreferrer">Open the shop in Google Maps</a></p>
    <div class="area-grid">
      <article>
        <h2>Las Vegas</h2>
        <p>The Strip, Downtown, Spring Valley, and Summerlin.</p>
        <p class="area-time">Mobile response typically 30–45 minutes.</p>
      </article>
      <article>
        <h2>Henderson</h2>
        <p>Green Valley, Whitney, and Henderson Executive Airport.</p>
        <p class="area-time">Mobile response typically 30–45 minutes.</p>
      </article>
      <article>
        <h2>North Las Vegas</h2>
        <p>Apex Industrial Park, the Cheyenne Tech Corridor, and the Craig Road industrial areas. The shop is here.</p>
        <p class="area-time">Mobile response typically 35–50 minutes.</p>
      </article>
      <article>
        <h2>Boulder City</h2>
        <p>Hoover Dam Bypass and US-93.</p>
        <p class="area-time">Mobile response typically 60–90 minutes.</p>
      </article>
      <article>
        <h2>Pahrump</h2>
        <p>The NV-160 corridor.</p>
        <p class="area-time">Mobile response typically 60–90 minutes, depending on location and availability.</p>
      </article>
      <article>
        <h2>The highways</h2>
        <p>24/7 roadside for commercial trucks on I-15, US-95, and US-93.</p>
        <p class="area-time">Coverage runs about 100 miles from the shop.</p>
      </article>
    </div>
  </div>
</section>
