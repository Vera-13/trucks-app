<% content_for :title, "Fleet Services | Trucks of Nevada" %>
<% set_meta_tags title: "Fleet Services", description: "We offer a full range of services to semi truck fleets in Las Vegas, NV." %>

<section class="fleet-services">
  <div class="container">
    <div class="content">
      <p>
        Take advantage of our fleet discounts on our services. If your business
        is based in or around <strong>Las Vegas, NV</strong>, stop by our shop to discuss a partnership.
      </p>
      <p>
        We offer a full range of services to semi truck fleets. You already cover
        most of the maintenance on your fleet? Contact us to find out more
        about our specialized services like <%= link_to "Roadside Assistance", roadside_assistance_path %>.
      </p>
      <h3>WHY CHOOSE US</h3>
      <div class="underline"></div>
      <ul class="reasons-list">
        <li><span class="check-icon">✔</span> We make the repair and maintenance more convenient for you</li>
        <li><span class="check-icon">✔</span> We are a friendly, helpful, and professional group of people</li>
        <li><span class="check-icon">✔</span> Our professionals know how to handle a wide range of semi truck services</li>
        <li><span class="check-icon">✔</span> We get the job done right — the first time</li>
        <li><span class="check-icon">✔</span> Fast service on most repairs and maintenance</li>
      </ul>

      <%= link_to services_path, class: "browse-services-btn" do %>
        BROWSE SERVICES
        <% end %>
    </div>
   <div class="images">
  <div class="main-image">
    <%# The main image is larger, so we give it a wider width %>
    <%= ik_image_tag("Trucks/fleet1.jpg", 
        transformation: [{ width: 1000, quality: 80 }], 
        alt: "Truck Fleet") 
    %>
  </div>
  <div class="additional-images">
    <%= ik_image_tag("Trucks/fleet2.jpg", 
        transformation: [{ width: 500, quality: 80 }], 
        loading: "lazy", 
        alt: "Truck Maintenance") 
    %>
    <%= ik_image_tag("Trucks/fleet3.jpg", 
        transformation: [{ width: 500, quality: 80 }], 
        loading: "lazy", 
        alt: "Fleet Trailers") 
    %>
  </div>
</div>
  </div>
</section>
