<% photo = page_photo(@service.slug) %>
<section class="page-hero <%= "has-photo" if photo %>" <% if photo %>style="<%= hero_photo_style(photo) %>"<% end %>>
  <div class="wrap">
    <p class="eyebrow"><%= link_to "Services", services_path %> / <%= @service.name %></p>
    <h1><%= @service.h1 %></h1>
    <% Array(@service.lede).each do |paragraph| %>
      <p class="lede"><%= paragraph %></p>
    <% end %>
    <%= phone_link (@service.button_label.presence || "Call Now (702) 333-2463"), class: "btn-call" %>
  </div>
</section>

<%= render "service_sections", sections: @service.lead_sections %>

<% shop = shop_photo(@service.slug) %>
<% if shop || @service.problems.present? || @service.included.present? %>
<section class="band">
  <div class="wrap">
    <% if shop %>
      <%= image_tag shop, alt: (@service.photo_alt.presence || "#{@service.name} at Trucks of Nevada"), class: "service-photo" %>
    <% end %>
    <% if @service.problems.present? || @service.included.present? %>
    <div class="split">
    <div>
      <h2><%= @service.problems_heading.presence || "What drivers call about" %></h2>
      <ul class="check-list">
        <% Array(@service.problems).each do |problem| %>
          <li><%= problem %></li>
        <% end %>
      </ul>
    </div>
    <div class="panel">
      <h2><%= @service.included_heading.presence || "What we do" %></h2>
      <ul class="plain-list">
        <% Array(@service.included).each do |item| %>
          <li><%= item %></li>
        <% end %>
      </ul>
    </div>
    </div>
    <% end %>
  </div>
</section>
<% end %>

<% if @service.detail_heading.present? %>
  <section class="band">
    <div class="wrap narrow">
      <h2><%= @service.detail_heading %></h2>
      <% before = Array(@service.detail_body) %>
      <% after = Array(@service.detail_after) %>
      <% if @service.detail_items.present? && after.empty? %>
        <% after = before.drop(1) %>
        <% before = before.first(1) %>
      <% end %>
      <% before.each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
      <% if @service.detail_items.present? %>
        <p><%= @service.detail_list_label.presence || "Our technicians service:" %></p>
        <ul class="check-list">
          <% @service.detail_items.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% end %>
      <% after.each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </section>
<% end %>

<%= render "service_sections", sections: @service.sections %>

<% if @service.steps.present? %>
  <section class="band band-dark">
    <div class="wrap">
      <h2>How we clean a DPF</h2>
      <ol class="steps">
        <% @service.steps.each do |step| %>
          <li><%= step %></li>
        <% end %>
      </ol>
    </div>
  </section>
<% end %>

<% if @service.fleets.present? %>
  <section class="band <%= "band-dark" if @service.steps.blank? %>">
    <div class="wrap narrow">
      <h2>Fleets and owner-operators</h2>
      <p><%= @service.fleets %></p>
    </div>
  </section>
<% end %>

<% if @service.faqs.present? %>
  <section class="band">
    <div class="wrap">
      <div class="faqs-block">
        <h2>Frequently asked questions</h2>
        <div class="faqs">
          <% @service.faqs.each do |question, answer| %>
            <details>
              <summary><%= question %></summary>
              <p><%= answer %></p>
            </details>
          <% end %>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json">
    <%= raw({
      "@context" => "https://schema.org",
      "@type" => "FAQPage",
      "mainEntity" => @service.faqs.map { |question, answer|
        {
          "@type" => "Question",
          "name" => question,
          "acceptedAnswer" => { "@type" => "Answer", "text" => answer }
        }
      }
    }.to_json) %>
  </script>
<% end %>

<% if @service.showcase %>
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <h2>The rest of the shop</h2>
        <p>These are the other jobs we do in the shop and on the road.</p>
      </div>
      <div class="card-grid">
        <% SiteContent.services.reject { |service| service.slug == @service.slug }.each_with_index do |service, index| %>
          <%= link_to public_send("#{service.slug.tr("-", "_")}_path"), class: "service-card service-card-compact" do %>
            <span class="card-icon"><i class="<%= service.icon %>"></i></span>
            <span class="card-body"><strong><%= service.name %></strong></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
