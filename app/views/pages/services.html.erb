<% used_photos = [] %>
<% photo = take_photo("services", used_photos) %>
<section class="page-hero <%= "has-photo" if photo %>" <% if photo %>style="<%= hero_photo_style(photo) %>"<% end %>>
  <div class="wrap">
    <p class="eyebrow">Las Vegas</p>
    <h1>Commercial truck services</h1>
    <p class="lede">Mechanical repair for semis, trailers, box trucks, motor homes, and cranes. We do not do tires, alignment, or body work.</p>
    <%= phone_link "Call Now (702) 333-2463", class: "btn-call" %>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="card-grid">
      <% SiteContent.services.each do |service| %>
        <%= link_to public_send("#{service.slug.tr("-", "_")}_path"), class: "service-card" do %>
          <% photo = shop_photo(service.slug) %>
          <% if photo %>
            <%= image_tag photo, alt: photo_alt(photo), class: "card-photo" %>
          <% else %>
            <span class="card-icon"><i class="<%= service.icon %>"></i></span>
          <% end %>
          <span class="card-body">
            <strong><%= service.name %></strong>
            <em><%= service.summary %></em>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
