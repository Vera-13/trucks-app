<% content_for :title, "Roadside Assistace | Trucks of Nevada" %>
<% set_meta_tags title: "Roadside Assistace", description: "Call us with your location and we will send our Roadside team to you" %>

<section class="emergency-banner">
  <div class="banner-content">
    <p>NEED EMERGENCY ROADSIDE ASSISTANCE NOW?</p>
    <a href="tel:+17023332463" class="call-button">CLICK TO CALL</a>
  </div>
</section>

<section class="we-are-here">
  <h2>WE ARE HERE FOR YOU</h2>

  <div class="underline"></div>
  <p>Call us with your location and we will send our Roadside team to you</p>

  <div class="features">
    <div class="feature">
      <div class="icon">
      <i class="fa-solid fa-map"></i>
      </div>
      <h3>SERVICING LAS VEGAS AREA</h3>
      <div class="underline"></div>
      <p>
        Whether it's a quarter mile or 100 miles away of Sin City, we are one-call away.
      </p>
    </div>
    <div class="feature">
      <div class="icon">
        <i class="fa-solid fa-clock"></i>
      </div>
      <h3>WE'RE HERE 24/7</h3>
      <div class="underline"></div>
      <p>
        Breakdowns happen day or night, but you can always rely that we will answer when you call.
      </p>
    </div>
    <div class="feature">
      <div class="icon">
      <i class="fa-solid fa-screwdriver-wrench"></i>
      </div>
      <h3>ANY SERVICE</h3>
      <div class="underline"></div>
      <p>
        As long as we can repair it on the side of the road, you can count on us.
      </p>
    </div>
  </div>
</section>

<section class="emergency-services">
  <div class="container">
    <div class="image">

       <%= ik_image_tag("Trucks/roadside.jpg", 
        transformation: [
          { crop: "at_max", quality: 80 }
        ], 
        loading: "lazy", 
        alt: "Emergency Services") 
    %>
    </div>
    <div class="content">
      <h2>EMERGENCY SERVICES</h2>
      <div class="underline"></div>
      <p>
        Whatever happened to your semi truck, we will do our best to get you back on the road.
      </p>
      <ul class="services-list">
        <li>
          <span class="check-icon">✔</span> Tubes & Hoses
        </li>
        <li>
          <span class="check-icon">✔</span> Coolant
        </li>
        <li>
          <span class="check-icon">✔</span> Jump Start
        </li>
        <li>
          <span class="check-icon">✔</span> Alternator
        </li>
        <li>
          <span class="check-icon">✔</span> Battery
        </li>
        <li>
          <span class="check-icon">✔</span> Fuel Delivery
        </li>
      </ul>
      <a href="tel:+17023332463" class="call-button">CALL RIGHT NOW</a>
    </div>
  </div>
</section>
